# ===========================================================================
#  MoodSync AnimeVision - Configuration
#  This file is git-ignored. Everything has a working default except PORT;
#  no API keys are required unless you enable the optional fallbacks below.
# ===========================================================================

PORT=3069

# ---------------------------------------------------------------------------
#  ANIME DATA SOURCE - Miruro - PRIMARY (AniList-mirror metadata)
#  Miruro is AniList-driven, so it mirrors the same data.
#  Point this at a working / self-hosted Miruro wrapper if the default is
#  unavailable.
# ---------------------------------------------------------------------------
MIRURO_API_BASE_URL=https://miruro.adgstudios.co.za
MIRURO_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
#  ANIME DATA SOURCE - AniList - BACKUP (free, no key needed)
#  GraphQL endpoint. Works out of the box; override only if you proxy AniList
#  through your own mirror. Also handles genre-only (mood) searches, which
#  Miruro cannot do.
# ---------------------------------------------------------------------------
ANILIST_GRAPHQL_URL=https://graphql.anilist.co
ANILIST_TIMEOUT_MS=15000
